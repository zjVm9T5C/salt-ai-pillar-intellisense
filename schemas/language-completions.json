        { "label": "ps-pipeline", "prefix": "where", "body": "${1:items} | Where-Object { $_.${2:Property} -eq ${3:value} }\n", "description": "Filtered pipeline" }
      ]
    },
    "HTML": {
      "label": "HTML",
      "aliases": ["html", "htm", "xhtml"],
      "extensions": [".html", ".htm", ".xhtml"],
      "keywords": ["<!DOCTYPE html>", "html", "head", "body", "div", "span", "p", "a", "ul", "ol", "li", "table", "tr", "td", "th", "form", "input", "button", "select", "script", "style", "meta", "title", "link", "section", "article", "header", "footer", "nav", "main", "h1", "h2", "h3", "h4", "h5", "h6"],
      "functions": [],
      "snippets": [
        { "label": "html-page", "prefix": "html", "body": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>${1:Title}</title>\n</head>\n<body>\n  $0\n</body>\n</html>\n", "description": "HTML page skeleton" },
        { "label": "html-list", "prefix": "ul", "body": "<ul>\n  <li>$0</li>\n</ul>\n", "description": "Unordered list" },
        { "label": "html-section", "prefix": "section", "body": "<section>\n  <h2>${1:Heading}</h2>\n  $0\n</section>\n", "description": "Section with heading" }
      ]
    },
    "CSS": {
      "label": "CSS",
      "aliases": ["css", "scss", "less"],
      "extensions": [".css", ".scss", ".less"],
      "keywords": ["color", "background", "background-color", "display", "flex", "grid", "margin", "padding", "width", "height", "min-width", "max-width", "border", "border-radius", "font-size", "font-family", "font-weight", "position", "absolute", "relative", "fixed", "sticky", "top", "right", "bottom", "left", "gap", "align-items", "justify-content", "flex-direction", "transition", "transform", "opacity", ":hover", ":focus", "::before", "::after"],
      "functions": ["rgb", "rgba", "hsl", "var", "calc", "min", "max", "clamp", "url", "linear-gradient"],
      "snippets": [
        { "label": "css-flex", "prefix": "flex", "body": "display: flex;\nalign-items: ${1:center};\njustify-content: ${2:center};\ngap: ${3:1rem};$0\n", "description": "Flex container" },
        { "label": "css-grid", "prefix": "grid", "body": "display: grid;\ngrid-template-columns: ${1:repeat(3, 1fr)};\ngap: ${2:1rem};$0\n", "description": "Grid container" },
        { "label": "css-media", "prefix": "media", "body": "@media (max-width: ${1:768px}) {\n  $0\n}\n", "description": "Responsive media query" }
      ]
    },
    "Markdown": {
      "label": "Markdown",
      "aliases": ["markdown", "md"],
      "extensions": [".md", ".markdown"],
      "keywords": ["#", "##", "###", "-", "*", "1.", ">", "```", "---"],
      "functions": [],
      "snippets": [
        { "label": "md-heading", "prefix": "heading", "body": "## ${1:Heading}\n\n$0\n", "description": "Second-level heading" },
        { "label": "md-list", "prefix": "list", "body": "- ${1:first}\n- ${2:second}\n- $0\n", "description": "Bullet list" },
        { "label": "md-code", "prefix": "code", "body": "```${1:language}\n$0\n```\n", "description": "Fenced code block" },
        { "label": "md-link", "prefix": "link", "body": "[${1:text}](${2:url})", "description": "Inline link" }
      ]
    }
  }
}
